# ============================================================
# VLM Business Card Lead Extraction — environment template
# Copy to .env and fill in. Never commit .env.
# ============================================================

# ============================================================
# Production only (deploy/docker-compose.prod.yml)
# Compose refuses to start without the first three.
# ============================================================

# Public hostname. With an Elastic IP and no domain, <dashed-ip>.sslip.io
# resolves to that IP and earns a real Let's Encrypt certificate with no DNS
# setup: 52.1.2.3 becomes 52-1-2-3.sslip.io
SITE_ADDRESS=

# Address Let's Encrypt uses for expiry notices.
ACME_EMAIL=

# Where the GGUF weights live on the host, mounted read-only into the model
# containers. Kept outside the checkout so a redeploy never re-downloads 13 GB.
MODELS_DIR=/opt/models

# ---- App ----
APP_ENV=development                 # development | production
APP_PORT=8000
APP_BASE_URL=http://localhost:5173
LOG_LEVEL=INFO
# Optional passcode gate for the public demo. Empty = open.
APP_ACCESS_CODE=

# ---- Database ----
POSTGRES_USER=leads
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=leads
POSTGRES_HOST=localhost
POSTGRES_PORT=5433   # 5433 avoids clashing with a locally installed PostgreSQL
DATABASE_URL=postgresql+asyncpg://leads:change-me-in-production@localhost:5433/leads

# ---- Storage ----
STORAGE_BACKEND=local               # local | s3
STORAGE_LOCAL_PATH=./storage
S3_BUCKET=
AWS_REGION=us-east-1

# ---- Upload limits ----
MAX_FILES_PER_JOB=50
MAX_FILE_SIZE_MB=10
IMAGE_MAX_EDGE_PX=768               # long-edge cap sent to the VLM

# ---- Retention ----
RETENTION_DAYS=7

# ---- Inference tier 1: GPU (llama.cpp CUDA / Metal) ----
VLM_GPU_ENABLED=true
# 18080 rather than 8080: that port is heavily contested in development
# (Airflow, Spark, Tomcat and others default to it), and pointing the app at
# an unrelated service produces a baffling failure. Production addresses the
# model servers by container name and is unaffected.
VLM_GPU_BASE_URL=http://127.0.0.1:18080/v1
VLM_GPU_MODEL=Qwen3VL-8B-Instruct-Q8_0
VLM_GPU_TIMEOUT_S=60

# ---- Inference tier 2: CPU (llama.cpp CPU build) ----
VLM_CPU_ENABLED=true
VLM_CPU_BASE_URL=http://127.0.0.1:18081/v1
VLM_CPU_MODEL=Qwen3VL-4B-Instruct-Q4_K_M
VLM_CPU_TIMEOUT_S=180

# ---- Inference tier 3: hosted Qwen (Alibaba Model Studio, Singapore) ----
# Sending a card here means the image leaves our server. Disclosed in the UI.
VLM_CLOUD_ENABLED=true
# Any OpenAI-compatible vision endpoint. Two measured options:
#   Alibaba Model Studio (Qwen, 1M free tokens for 90 days, Singapore only)
#     https://dashscope-intl.aliyuncs.com/compatible-mode/v1   qwen3-vl-plus
#   Google AI Studio (Gemini free tier, no card; prompts may be used by Google)
#     https://generativelanguage.googleapis.com/v1beta/openai/  gemini-3.6-flash,gemini-3.1-flash-lite
# A comma-separated model list is tried in order when one is retired or busy.
VLM_CLOUD_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
VLM_CLOUD_MODEL=qwen3-vl-plus
VLM_CLOUD_API_KEY=
VLM_CLOUD_TIMEOUT_S=90
VLM_CLOUD_JSON_SCHEMA=true          # false if the endpoint rejects response_format json_schema
VLM_CLOUD_MAX_RETRIES=2             # on 429/5xx, honouring Retry-After
VLM_CLOUD_DAILY_REQUEST_LIMIT=1000  # shared ceiling per UTC day; 0 = none

# ---- Circuit breaker ----
BREAKER_FAILURE_THRESHOLD=3
BREAKER_RESET_SECONDS=60
PROVIDER_HEALTH_INTERVAL_S=15

# ---- Worker ----
WORKER_CONCURRENCY=2
TASK_MAX_ATTEMPTS=2
TASK_LEASE_SECONDS=300

# ---- Rate limits (per IP) ----
RATE_LIMIT_JOBS=5/10minutes
RATE_LIMIT_IMAGES_PER_HOUR=100
